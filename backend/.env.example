# Supabase: Project Settings > API. Use the service_role key, on the server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# LLM (Groq free key from console.groq.com/keys). Optional: without it the review shows rule checks only.
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Comma-separated origins allowed to call this API. Use your Vercel URL in production.
ALLOWED_ORIGINS=http://localhost:5173
